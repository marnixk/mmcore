' Define the array and number of words
DIM total_words = 200
DIM words$(total_words - 1)

Sub LoadWords()
  global words$
  local word_idx

  ' Load the words into the array
  RESTORE WordList
  FOR word_idx = 0 TO total_words - 1
    READ words$(word_idx)
  NEXT word_idx

End Sub

LoadWords()

' Your word list follows
WordList:
DATA "ant", "bat", "bed", "bee", "big", "box", "boy", "bus", "can", "cat"
