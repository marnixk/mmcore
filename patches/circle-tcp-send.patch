+void CNetBufferQueue::EnqueueFront (CNetBuffer *pNetBuffer)
+{
+	assert (pNetBuffer);
+	assert (!pNetBuffer->m_pNext);
+
+	size_t ulLength = pNetBuffer->GetLength ();
+
+	if (m_bProtected)
+	{
+		m_SpinLock.Acquire ();
+	}
+
+	pNetBuffer->m_pNext = m_pFirst;
+	m_pFirst = pNetBuffer;
+	if (!m_pLast)
+	{
+		m_pLast = pNetBuffer;
+	}
+
+	m_nEntries++;
+	m_ulBytes += ulLength;
+
+	if (!m_pPeekHead)
+	{
+		m_pPeekHead = pNetBuffer;
+	}
+
+	if (m_bProtected)
+	{
+		m_SpinLock.Release ();
+	}
+}
