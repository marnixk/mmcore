+// mmbasic-console-state: virtual console snapshot/restore of the text buffer.
+unsigned CTerminalDevice::GetConsoleBufferSize (void) const
+{
+	return m_nSize;
+}
+
+void CTerminalDevice::SaveConsole (void *pBuffer, unsigned *pCursorX, unsigned *pCursorY)
+{
+	if (m_bCursorVisible)
+	{
+		InvertCursor ();	// erase the cursor from the buffer
+	}
+
+	if (pBuffer)
+	{
+		memcpy (pBuffer, m_pBuffer8, m_nSize);
+	}
+
+	if (pCursorX)
+	{
+		*pCursorX = m_nCursorX;
+	}
+
+	if (pCursorY)
+	{
+		*pCursorY = m_nCursorY;
+	}
+}
+
+void CTerminalDevice::RestoreConsole (const void *pBuffer, unsigned nCursorX, unsigned nCursorY)
+{
+	if (m_bCursorVisible)
+	{
+		InvertCursor ();	// erase the cursor currently in the buffer
+	}
+
+	if (pBuffer)
+	{
+		memcpy (m_pBuffer8, pBuffer, m_nSize);
+	}
+
+	m_nCursorX = nCursorX;
+	m_nCursorY = nCursorY;
+
+	InvertCursor ();	// draw the cursor at the restored position
+
+	// Repaint the whole text area.
+	m_UpdateArea.x1 = 0;
+	m_UpdateArea.x2 = m_nWidth-1;
+	m_UpdateArea.y1 = 0;
+	m_UpdateArea.y2 = m_nHeight-1;
+	m_pDisplay->SetArea (m_UpdateArea, m_pBuffer8);
+
+	m_UpdateArea.y1 = m_nHeight;
+	m_UpdateArea.y2 = 0;
+}
