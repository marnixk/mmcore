+boolean CReassemblyQueue::TrimSegment (u32 *pSEG_SEQ, CNetBuffer *pPacket, u32 nRCV_NXT)
+{
+	assert (pSEG_SEQ);
+	assert (pPacket);
+
+	if (!lt (*pSEG_SEQ, nRCV_NXT))
+	{
+		return FALSE;
+	}
+
+	size_t ulLength = pPacket->GetLength ();
+	u32 nSkip = nRCV_NXT - *pSEG_SEQ;
+	if (nSkip > ulLength)
+	{
+		nSkip = ulLength;
+	}
+
+	if (nSkip > 0)
+	{
+		pPacket->RemoveHeader (nSkip);
+	}
+
+	*pSEG_SEQ = nRCV_NXT;
+
+	return TRUE;
+}
