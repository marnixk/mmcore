diff --git a/lib/usb/usbcdcethernet.cpp b/lib/usb/usbcdcethernet.cpp
index 88b3a352..0e420d89 100644
--- a/lib/usb/usbcdcethernet.cpp
+++ b/lib/usb/usbcdcethernet.cpp
@@ -151,6 +151,21 @@ boolean CUSBCDCEthernetDevice::SendFrame (const void *pBuffer, unsigned nLength)
 	assert (m_pEndpointBulkOut != 0);
 	assert (pBuffer != 0);
 	assert (nLength <= FRAME_BUFFER_SIZE);
+
+	// mmbasic-usb-cdc-rx: a bulk OUT transfer whose size is an exact multiple
+	// of the endpoint packet size carries no terminating short packet, so
+	// QEMU's usb-net (and some CDC peers) hold the frame until the next
+	// transfer arrives and the sender stalls. Append one padding byte, which
+	// Ethernet receivers ignore, so every transfer ends in a short packet.
+	unsigned nMaxPacketSize = m_pEndpointBulkOut->GetMaxPacketSize ();
+	if (nMaxPacketSize != 0 && (nLength % nMaxPacketSize) == 0)
+	{
+		memcpy (m_TxBuffer, pBuffer, nLength);
+		m_TxBuffer[nLength] = 0;
+
+		return GetHost ()->Transfer (m_pEndpointBulkOut, m_TxBuffer, nLength + 1) >= 0;
+	}
+
 	return GetHost ()->Transfer (m_pEndpointBulkOut, (void *) pBuffer, nLength) >= 0;
 }
 
