 }
 
+void CTransportLayer::AbortConnecting (void)
+{
+	unsigned i;
+
+	for (i = 0; i < m_pConnection.GetCount (); i++)
+	{
+		CNetConnection *pConn = (CNetConnection *) m_pConnection[i];
+		if (pConn == 0)
+			continue;
+		if (pConn->GetProtocol () != IPPROTO_TCP)
+			continue;
+		const char *pState = pConn->GetStateName ();
+		if (pState != 0 && strcmp (pState, "SYN-SENT") == 0)
+			pConn->Close ();
+	}
+}
