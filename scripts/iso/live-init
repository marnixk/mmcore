#!/bin/busybox sh
# PID 1 for the live ISO and for a disk installed by mmcore-install.
#
# GRUB only loads this small initramfs. The root filesystem is a squashfs on
# the same media; the kernel's own block driver reads it (large sequential
# I/O) instead of the firmware USB stack.
set -eu

# Applets are not on PATH until --install. A missing /proc makes this
# script exit and the kernel panic.
/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin \
	/proc /sys /dev /etc/modprobe.d \
	/mnt/media /mnt/lower /mnt/rw /newroot

/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# The ThinkPad T420's Renesas USB 3.0 controller stalls on UAS. Bind the boot
# disk with usb-storage (bulk-only) by never loading uas here.
printf 'blacklist uas\n' > /etc/modprobe.d/blacklist-uas.conf

for mod in \
	loop squashfs overlay isofs vfat fat \
	nls_cp437 nls_iso8859_1 nls_utf8 nls_ascii \
	usb-storage usbcore usb-common \
	xhci-pci xhci-hcd ehci-pci ehci-hcd uhci-hcd ohci-pci ohci-hcd \
	sd_mod sr_mod cdrom scsi_mod \
	ata_piix ata_generic ahci libahci libata \
	virtio_pci virtio_blk virtio_scsi virtio virtio_ring \
	mmc_block mmc_core sdhci sdhci-pci
do
	modprobe "$mod" 2>/dev/null || true
done

# #976: a disk installed by mmcore-install also has /boot/rootfs.squashfs on
# its MMCORE-SYS partition, so scanning for that file alone can run the
# installed build on a live boot. The live ISO carries a marker at its root
# (mmcore-live-media) that the installer never copies to a disk; GRUB pins
# $root to it and passes mmcore.live=1. On a live boot, mount only the marked
# media.
live_boot=0
for arg in $(cat /proc/cmdline 2>/dev/null); do
	case "$arg" in
		mmcore.live=*) live_boot=1 ;;
	esac
done

try_one() {
	dev="$1"
	[ -b "$dev" ] || return 1
	mount -o ro "$dev" /mnt/media 2>/dev/null || return 1
	if [ -f /mnt/media/boot/rootfs.squashfs ]; then
		return 0
	fi
	umount /mnt/media 2>/dev/null || true
	return 1
}

# The live marker is the boot media's own identity: require it *and* the
# squashfs, so an installed disk (or any other squashfs) is never accepted.
try_live_media() {
	dev="$1"
	[ -b "$dev" ] || return 1
	mount -o ro "$dev" /mnt/media 2>/dev/null || return 1
	if [ -f /mnt/media/mmcore-live-media ] \
		&& [ -f /mnt/media/boot/rootfs.squashfs ]; then
		return 0
	fi
	umount /mnt/media 2>/dev/null || true
	return 1
}

scan_media() {
	probe="$1"
	i=0
	while [ "$i" -lt 30 ]; do
		for dev in /dev/sr* /dev/sd* /dev/vd* /dev/nvme*n* /dev/mmcblk*; do
			if "$probe" "$dev"; then
				return 0
			fi
		done
		i=$((i + 1))
		sleep 1
	done
	return 1
}

found=0
# Prefer the marked live media; an installed disk (mmcore.sys=, no marker) and
# older images without the marker fall through to the generic scan.
if [ "$live_boot" = 1 ]; then
	scan_media try_live_media && found=1
fi
if [ "$found" != 1 ]; then
	scan_media try_one && found=1
fi

if [ "$found" != 1 ]; then
	printf '%s\n' 'mmcore: no rootfs.squashfs found' > /dev/console 2>/dev/null || true
	printf '%s\n' 'mmcore: no rootfs.squashfs found' > /dev/tty0 2>/dev/null || true
	exec sh
fi

if ! mount -t squashfs -o loop,ro /mnt/media/boot/rootfs.squashfs /mnt/lower; then
	losetup /dev/loop0 /mnt/media/boot/rootfs.squashfs
	mount -t squashfs -o ro /dev/loop0 /mnt/lower
fi
mount -t tmpfs -o mode=755 tmpfs /mnt/rw
mkdir -p /mnt/rw/upper /mnt/rw/work
mount -t overlay overlay \
	-o lowerdir=/mnt/lower,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work \
	/newroot

mkdir -p /newroot/mnt/live/media /newroot/mnt/live/lower /newroot/mnt/live/rw
mkdir -p /newroot/dev /newroot/proc /newroot/sys
mount --move /mnt/media /newroot/mnt/live/media
mount --move /mnt/lower /newroot/mnt/live/lower
mount --move /mnt/rw /newroot/mnt/live/rw
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys

exec switch_root /newroot /sbin/init
printf '%s\n' 'mmcore: switch_root failed' > /dev/tty0 2>/dev/null || true
exec sh
