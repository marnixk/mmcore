# Filesystems used by the installer/updater (#891, #892): the live media is
# ISO9660 and the installed MMCORE-SYS partition is FAT32. Missing modules are
# ignored.
isofs
vfat
nls_cp437
nls_iso8859-1

# MMC/SD card-reader host controllers. A microSD written with
# install-usb.sh --read-write must stay visible so its MMCORE partition can be
# mounted as C: (and, on a live boot, as the overlay's upper layer). Some
# Chromebooks expose the card only through one of these modular host drivers,
# so a missing one means C: falls back to RAM. Missing modules are ignored.
rtsx_pci
rtsx_pci_sdmmc
rtsx_usb
rtsx_usb_sdmmc
sdhci
sdhci_pci
sdhci_acpi
sdhci_pltfm
mmc_block
mmc_core

# KMS/DRM graphics drivers for common GPUs. Missing modules are ignored, so
# this list is safe on hardware that does not match. i915 covers Intel
# integrated graphics (including Chromebooks); amdgpu/radeon/nouveau cover the
# other desktop parts.
i915
amdgpu
radeon
nouveau
virtio_gpu
virtio-gpu
bochs
bochs-drm

# Intel Chromebooks (#864). cros_ec is the embedded controller (keyboard,
# touchpad, sensors); i2c-hid + hid_multitouch drive the I2C touchpad and
# touchscreen. These are modular in Alpine's linux-lts, so list them here.
cros_ec
cros_ec_chardev
cros_ec_dev
cros_ec_i2c
cros_ec_spi
cros_ec_sysfs
cros_ec_lpcs
i2c_hid_acpi
i2c_hid_of
i2c_hid
hid_multitouch

# Chromebook built-in touchpads that are not an ACPI-enumerated I2C-HID
# device (#1039). #864 covered the EC + I2C-HID path; a Chromebook whose
# touchpad binds through a bus or board driver still did nothing, and a USB
# mouse on the same machine worked. Every name here is a module in Alpine's
# linux-lts and binds only when the matching controller/device is present, so
# the list is safe on hardware that does not match; a name the kernel does not
# build is ignored by modprobe. The live ISO ships them and the
# mmcore-touchpad.start helper re-loads them late; no manual modprobe is
# needed.
#
# Note: the ACPI DesignWare I2C host driver -- `i2c-designware-platform`,
# which binds ACPI INT33C2/INT33C3, 80860F41/808622C1 (Intel LPSS) and
# AMD0010/AMDI0010 (AMD Chromebooks), i.e. the touchpad bus on most
# Chromebooks -- is *built in* to Alpine's linux-lts
# (CONFIG_I2C_DESIGNWARE_PLATFORM=y), so that adapter comes up with no module.
# Only the PCI variant is modular.
# Intel LPSS/DesignWare + PCH/SMBus I2C host controllers.
intel_lpss
intel_lpss_acpi
intel_lpss_pci
i2c_designware_pci
i2c_i801
i2c_piix4
i2c_scmi
i2c_smbus
# Older Chromebooks instantiate the touchpad's I2C client from a DMI table
# instead of ACPI, so the platform driver must be loaded by name.
chromeos_laptop
# Chromebooks whose touchpad/EC hangs off the Intel Integrated Sensor Hub
# (HID-over-ISH): the ISH IPC and HID transport, plus the ChromeOS EC ISH link.
intel_ishtp
intel_ish_ipc
intel_ishtp_hid
cros_ec_ishtp
# Touchpad drivers by controller family: Cypress, Elan, Synaptics (native and
# RMI4), Alps, plus the HID transport drivers for those parts, and the legacy
# PS/2 touchpad some models expose through the EC.
cyapatp
elan_i2c
synaptics_i2c
rmi_core
rmi_i2c
hid_elan
hid_rmi
hid_alps
psmouse

# Sound Open Firmware (SOF) audio on Intel Chromebooks (#864). sof-firmware
# supplies the DSP firmware; the modules bind when a SOF PCI/ACPI device is
# present and are harmless otherwise.
snd_sof
snd_sof_pci
snd_sof_acpi
snd_sof_intel_hda_common
snd_sof_intel_hda
