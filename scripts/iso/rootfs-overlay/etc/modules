# Filesystems used by the installer/updater (#891, #892): the live media is
# ISO9660 and the installed MMCORE-SYS partition is FAT32. Missing modules are
# ignored.
isofs
vfat
nls_cp437
nls_iso8859-1

# MMC/SD card-reader host controllers. A microSD written with
# install-usb.sh --read-write must stay visible so its MMCORE partition can be
# mounted as C: (and, on a live boot, as the overlay's upper layer). Some
# Chromebooks expose the card only through one of these modular host drivers,
# so a missing one means C: falls back to RAM. Missing modules are ignored.
rtsx_pci
rtsx_pci_sdmmc
rtsx_usb
rtsx_usb_sdmmc
sdhci
sdhci_pci
sdhci_acpi
sdhci_pltfm
mmc_block
mmc_core

# KMS/DRM graphics drivers for common GPUs. Missing modules are ignored, so
# this list is safe on hardware that does not match. i915 covers Intel
# integrated graphics (including Chromebooks); amdgpu/radeon/nouveau cover the
# other desktop parts.
i915
amdgpu
radeon
nouveau
virtio_gpu
virtio-gpu
bochs
bochs-drm

# Intel Chromebooks (#864). cros_ec is the embedded controller (keyboard,
# touchpad, sensors); i2c-hid + hid_multitouch drive the I2C touchpad and
# touchscreen. These are modular in Alpine's linux-lts, so list them here.
cros_ec
cros_ec_chardev
cros_ec_dev
cros_ec_i2c
cros_ec_spi
cros_ec_sysfs
cros_ec_lpcs
i2c_hid_acpi
i2c_hid_of
i2c_hid
hid_multitouch

# Sound Open Firmware (SOF) audio on Intel Chromebooks (#864). sof-firmware
# supplies the DSP firmware; the modules bind when a SOF PCI/ACPI device is
# present and are harmless otherwise.
snd_sof
snd_sof_pci
snd_sof_acpi
snd_sof_intel_hda_common
snd_sof_intel_hda
