#!/bin/sh
# Bring up wired interfaces with DHCP at boot. Saved Wi-Fi credentials are
# joined by mmcore itself: the first mmb_poll() drives mmb_wlan_start(), so
# OPTION WIFI is only needed to scan/change. OPTION ETHERNET ON restarts
# networking.
for path in /sys/class/net/*; do
	[ -d "${path}" ] || continue
	name="${path##*/}"
	[ "${name}" = "lo" ] && continue
	[ -d "${path}/wireless" ] && continue
	ip link set "${name}" up 2>/dev/null || true
	udhcpc -i "${name}" -b -q -n >/dev/null 2>&1 || true
done
